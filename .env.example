# Orderly — Environment Variables
# Copy this to .env.local and fill in your values.
# For Vercel deployment, add these in the Vercel dashboard → Settings → Environment Variables.

# Database (Neon Postgres — pooled connection for serverless)
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&pgbouncer=true&connection_limit=3&pool_timeout=60
DIRECT_URL=postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require

# Auth (Clerk — for production deployment)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# AI (Nvidia OpenAI-compatible API — free tier, NOT OpenAI)
AI_API_KEY=nvapi_xxx
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=z-ai/glm-5.2

# WhatsApp (Evolution API — self-hosted on Render)
EVOLUTION_API_URL=https://your-evolution-instance.onrender.com
EVOLUTION_GLOBAL_API_KEY=your-global-api-key
EVOLUTION_WEBHOOK_SECRET=your-webhook-secret

# Payments (PayFast — South African gateway)
PAYFAST_MERCHANT_ID=your-merchant-id
PAYFAST_MERCHANT_KEY=your-merchant-key
PAYFAST_PASSPHRASE=your-passphrase
PAYFAST_MODE=sandbox
PAYFAST_ENFORCE_IP=false

# App config
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app
CRON_SECRET=your-cron-secret

# Session auth (used when Clerk is not active — sandbox/dev fallback)
SESSION_SECRET=change-this-to-a-long-random-string
